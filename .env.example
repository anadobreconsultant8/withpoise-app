# ─── DATABASE (Neon PostgreSQL — neon.tech) ──────────────────────────────────
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# ─── NEXTAUTH ─────────────────────────────────────────────────────────────────
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secure-random-secret"
NEXTAUTH_URL="https://withpoise.net"

# ─── ANTHROPIC API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Plan Price IDs (recurring monthly prices)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...

# Stripe Credit Pack Price IDs (one-time prices)
STRIPE_CREDITS_BOOST_PRICE_ID=price_...
STRIPE_CREDITS_GROWTH_PRICE_ID=price_...
STRIPE_CREDITS_POWER_PRICE_ID=price_...

# ─── UPSTASH REDIS (rate limiting — upstash.com) ──────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── RESEND (transactional email — resend.com) ────────────────────────────────
RESEND_API_KEY=re_...
